    {
      "id": "msg_0e0c4cbd8e0d96ca016af4fa39a3b887d2aea6c7eb924cc0a6",
      "content": [
        {
          "annotations": [],
          "text": "{\n  \"scope\": {\n    \"document_ids\": [\"HDMS-PROS-01\"],\n    \"verification_limits\": [\n      \"기존 출력은 제공된 물리 페이지와 공시 인용값을 사용한 것으로 기록되어 있다. 비교기업의 사업보고서, 거래가격 및 환율 원자료는 독립적으로 확인하지 않았다.\",\n      \"이번 형식 수리에는 문서 원문이 별도로 제공되지 않아 기존 출력의 사실과 인용 위치를 재검증하지 않았다.\",\n      \"허용 문서의 공개 시각은 2024-04-24라는 날짜까지만 확인됐다. 자료 마감은 같은 날 23:59:59 KST다.\",\n      \"민감도는 주당 평가가액에 관한 계산이며 적정 공모가 예측이나 투자 승인이 아니다.\"\n    ]\n  },\n  \"judgments\": [\n    {\n      \"judgment_id\": \"J1\",\n      \"domain\": \"J1\",\n      \"conclusion\": \"2023년 온기 연결 지배주주순이익을 적용한 것은 비교기업의 온기 지배주주순이익 기준과 기간·귀속 범위가 맞아 조건부로 비교 가능하다. 표시 정밀도 때문에 공시 평가시가총액은 표시 배수만으로 정확히 재현되지 않는다.\",\n      \"disposition\": \"CONDITIONAL\",\n      \"facts\": [\n        {\n          \"claim_id\": \"R_J1_EARNINGS\",\n          \"text\": \"공시 사실: 적용 이익은 151,116백만원이다. 연결재무정보의 2023년 1월 1일~12월 31일 지배기업 소유주 귀속 순이익은 151,116,175,331원이며 비지배지분 순이익은 없다. 비교기업에도 2023년 온기 지배주주순이익을 적용했다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0421\",\n              \"page\": 421,\n              \"claim_id\": \"R_J1_EARNINGS\",\n              \"locator\": \"요약 연결 재무정보, 2023년 당기순이익과 지배기업소유지분\"\n            },\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0331\",\n              \"page\": 331,\n              \"claim_id\": \"R_J1_EARNINGS\",\n              \"locator\": \"평가 시가총액 산출 내역 및 2023년 온기 기준 PER 산출\"\n            }\n          ]\n        },\n        {\n          \"claim_id\": \"R_J1_SHARES\",\n          \"text\": \"재계산: 공모 전 40,000,000주 + 신주 4,450,000주 + 희석가능 420,190주 = 44,870,190주다. 희석가능분은 주식매수선택권 13,510주와 우리사주매수선택권 잔여 406,680주다. 구주매출 4,450,000주는 기존 주식이므로 다시 더하지 않는다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0332\",\n              \"page\": 332,\n              \"claim_id\": \"R_J1_SHARES\",\n              \"locator\": \"주당 평가가액 산출 내역 및 희석가능주식수 주석\"\n            }\n          ]\n        },\n        {\n          \"claim_id\": \"R_J1_RECALC\",\n          \"text\": \"재계산: 표시 이익 151,116백만원 × 표시 PER 31.5배 = 4,760,154백만원이고, 이를 44,870,190주로 나누면 약 106,087원이다. 반면 공시 평가시가총액 4,761,293백만원을 나누면 106,112.61원으로 공시 평가가액 106,113원과 원 단위 반올림상 일치한다. 공시 시가총액을 표시 이익으로 역산한 배수는 약 31.50754배다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0331\",\n              \"page\": 331,\n              \"claim_id\": \"R_J1_RECALC\",\n              \"locator\": \"적용 순이익 및 2023년 온기 기준 PER 산출\"\n            },\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0332\",\n              \"page\": 332,\n              \"claim_id\": \"R_J1_RECALC\",\n              \"locator\": \"평가 시가총액 및 주당 평가가액 산출 내역\"\n            }\n          ]\n        },\n        {\n          \"claim_id\": \"R_J1_PRECISION\",\n          \"text\": \"재계산: 공시에 인용된 각 비교기업의 시가총액과 이익을 나눈 배수의 평균은 약 31.50755배이고, 이를 표시 이익과 주식수에 적용하면 약 106,112.66원이다. 표시 배수만 사용한 결과와의 차이는 미표시 정밀도로 설명 가능한 수준이나 실제 처리 규칙을 확인한 것은 아니다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0331\",\n              \"page\": 331,\n              \"claim_id\": \"R_J1_PRECISION\",\n              \"locator\": \"2023년 온기 기준 PER 산출, 각 사 기준시가총액과 지배주주순이익\"\n            }\n          ]\n        },\n        {\n          \"claim_id\": \"R_J1_METHOD\",\n          \"text\": \"공시는 PER 평가방법을 통한 상대가치 산출 방법을 제시한다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0330\",\n              \"page\": 330,\n              \"claim_id\": \"R_J1_METHOD\",\n              \"locator\": \"PER 평가방법을 통한 상대가치 산출, 산출 방법\"\n            }\n          ]\n        },\n        {\n          \"claim_id\": \"R_J1_ACCOUNTING_LIMIT\",\n          \"text\": \"공시는 PER 평가방법의 한계로 비교기업 간 회계기준 및 연결 대상 기준 차이를 설명한다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0331\",\n              \"page\": 331,\n              \"claim_id\": \"R_J1_ACCOUNTING_LIMIT\",\n              \"locator\": \"PER 평가방법의 한계점: 비교기업 간 회계기준 및 연결 대상 기준 차이\"\n            }\n          ]\n        },\n        {\n          \"claim_id\": \"R_J1_SEPARATE_EARNINGS\",\n          \"text\": \"공시의 2023년 별도 당기순이익은 143,474,006,953원이다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0423\",\n              \"page\": 423,\n              \"claim_id\": \"R_J1_SEPARATE_EARNINGS\",\n              \"locator\": \"요약 별도 재무정보, 2023년 당기순이익\"\n            }\n          ]\n        }\n      ],\n      \"evidence\": [\n        {\n          \"doc_id\": \"HDMS-PROS-01\",\n          \"chunk_id\": \"HDMS-PROS-01-p0330\",\n          \"page\": 330,\n          \"claim_id\": \"R_J1_METHOD\",\n          \"locator\": \"PER 평가방법을 통한 상대가치 산출, 산출 방법\"\n        }\n      ],\n      \"counter_evidence\": [\n        {\n          \"doc_id\": \"HDMS-PROS-01\",\n          \"chunk_id\": \"HDMS-PROS-01-p0331\",\n          \"page\": 331,\n          \"claim_id\": \"R_J1_ACCOUNTING_LIMIT\",\n          \"locator\": \"PER 평가방법의 한계점: 비교기업 간 회계기준 및 연결 대상 기준 차이\"\n        },\n        {\n          \"doc_id\": \"HDMS-PROS-01\",\n          \"chunk_id\": \"HDMS-PROS-01-p0423\",\n          \"page\": 423,\n          \"claim_id\": \"R_J1_SEPARATE_EARNINGS\",\n          \"locator\": \"요약 별도 재무정보, 2023년 당기순이익\"\n        }\n      ],\n      \"unknowns\": [\n        \"개별 비교기업의 독립 원자료와 공시 계산에 실제 사용된 미표시 자릿수·반올림 규칙은 확인하지 못했다.\",\n        \"확인한",
