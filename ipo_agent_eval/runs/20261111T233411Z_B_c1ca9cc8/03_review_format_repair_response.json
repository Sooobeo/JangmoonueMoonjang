    {
      "id": "msg_0265aee935082b7f016af4fbed513087d28d946e9073d196f3",
      "content": [
        {
          "annotations": [],
          "text": "{\n  \"scope\": {\n    \"document_ids\": [\"HDMS-PROS-01\"],\n    \"verification_limits\": [\n      \"2024-04-24 정정 투자설명서의 실제 공개 시각은 날짜까지만 확인되었다. 제공받은 물리 페이지 범위에서만 검토했다.\",\n      \"비교기업의 독립 재무공시, 주가와 환율 원자료는 직접 확인하지 않았다. 비교기업 재계산은 투자설명서의 인용값을 사용했다.\",\n      \"추가 검색은 하지 않았다. 아래 정보 요청은 기록이며 답변을 확보한 것이 아니다.\"\n    ]\n  },\n  \"judgments\": [\n    {\n      \"judgment_id\": \"J1\",\n      \"domain\": \"J1\",\n      \"conclusion\": \"2023년 온기 연결 지배주주 귀속 순이익을 적용한 선택은 비교기업의 공시상 이익 기간과 귀속 기준에 부합한다. 다만 회사별 회계기준과 연결 범위의 완전한 일치까지 확인한 것은 아니므로 조건부로 해석한다.\",\n      \"disposition\": \"CONDITIONAL\",\n      \"facts\": [\n        {\n          \"claim_id\": \"R_J1_EARN\",\n          \"text\": \"발행사의 2023년 연결 당기순이익과 지배기업 소유주 귀속 순이익은 모두 151,116,175,331원이며, 비지배지분 귀속액은 없다. 평가표의 적용 순이익은 백만원 단위로 151,116이다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0425\",\n              \"page\": 425,\n              \"claim_id\": \"R_J1_EARN\",\n              \"locator\": \"연결 포괄손익계산서, 당기순이익 및 당기순이익의 귀속\"\n            },\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0331\",\n              \"page\": 331,\n              \"claim_id\": \"R_J1_EARN\",\n              \"locator\": \"평가 시가총액 산출 내역, 적용 순이익\"\n            }\n          ]\n        },\n        {\n          \"claim_id\": \"R_J1_COMPARE\",\n          \"text\": \"공시는 비교기업에도 2023년 온기 지배주주순이익을 적용했다고 명시한다. 발행사의 2023년 별도 당기순이익은 143,474,006,953원으로 연결 적용 이익과 다르다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0331\",\n              \"page\": 331,\n              \"claim_id\": \"R_J1_COMPARE\",\n              \"locator\": \"2023년 온기 기준 PER 산출 및 주2\"\n            },\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0423\",\n              \"page\": 423,\n              \"claim_id\": \"R_J1_COMPARE\",\n              \"locator\": \"요약 별도 재무정보, 2023년 당기순이익\"\n            }\n          ]\n        }\n      ],\n      \"evidence\": [\n        {\n          \"doc_id\": \"HDMS-PROS-01\",\n          \"chunk_id\": \"HDMS-PROS-01-p0330\",\n          \"page\": 330,\n          \"claim_id\": \"J1\",\n          \"locator\": \"PER 평가방법을 통한 상대가치 산출, 산출 방법\"\n        }\n      ],\n      \"counter_evidence\": [\n        {\n          \"doc_id\": \"HDMS-PROS-01\",\n          \"chunk_id\": \"HDMS-PROS-01-p0331\",\n          \"page\": 331,\n          \"claim_id\": \"J1\",\n          \"locator\": \"PER 평가방법의 한계점: 회계기준 및 연결 대상 차이\"\n        }\n      ],\n      \"unknowns\": [\n        \"비교기업별 독립 재무제표와 회계기준·연결 대상의 세부 차이는 직접 대조하지 못했다.\",\n        \"제공 페이지에서 적용 이익에 별도의 연환산이나 조정을 했다는 근거는 확인되지 않았다.\"\n      ],\n      \"next_action\": \"동일 기간·귀속 범위를 전제로 PER 비교를 이어가되, 독립 원자료가 허용·제공되면 각 비교기업의 연결 범위와 이익을 대조한다.\"\n    },\n    {\n      \"judgment_id\": \"J2\",\n      \"domain\": \"J2\",\n      \"conclusion\": \"네 비교기업의 평균은 선박 관련 공급망을 참고하는 배수로 조건부 사용 가능하다. 다만 제조·신조와 비해양 사업의 비중이 달라 발행사와 동일한 위험·성장성을 가진 순수 비교군으로 볼 수 없다.\",\n      \"disposition\": \"CONDITIONAL\",\n      \"facts\": [\n        {\n          \"claim_id\": \"R_J2_PEERS\",\n          \"text\": \"최종 비교기업과 표시 PER은 HD한국조선해양 36.5배, ALFA LAVAL 25.6배, KONGSBERG 31.8배, WARTSILA 32.1배다. 2024-03-14 기준 최근 종가, 1주일 및 1개월 평균 중 낮은 주가를 기준시가총액에 적용했다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0331\",\n              \"page\": 331,\n              \"claim_id\": \"R_J2_PEERS\",\n              \"locator\": \"2023년 온기 기준 PER 산출 및 주1\"\n            },\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0330\",\n              \"page\": 330,\n              \"claim_id\": \"R_J2_PEERS\",\n              \"locator\": \"비교회사 기준시가총액 산정내역, 기준주가 및 주1\"\n            }\n          ]\n        },\n        {\n          \"claim_id\": \"R_J2_MIX\",\n          \"text\": \"발행사의 2023년 연결 매출 하위 제품군은 AM솔루션 42%, 벙커링 41%, 친환경개조 12%, SDV 4%다. 비교기업의 최근 결산 매출 구성에는 HD한국조선해양 조선 83.1%, ALFA LAVAL Marine 30.0%, KONGSBERG Maritime 49.7%, WARTSILA Energy 43.4%가 포함된다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0309\",\n              \"page\": 309,\n              \"claim_id\": \"R_J2_MIX\",\n              \"locator\": \"사업 유사성 본문 및 3차 비교회사 선정 결과, ALFA LAVAL\"\n            },\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0310\",\n              \"page\": 310,\n              \"claim_id\": \"R_J2_MIX\",\n              \"locator\": \"사업 유사성 기준 3차 비교회사 선정 결과, HD한국조선해양·KONGSBERG·WARTSILA\"\n            }\n          ]\n        },\n        {\n          \"claim_id\": \"R_J2_DIFFERENCE\",\n          \"text\": \"발행사는 주요 부품·기자재를 직접 제조하지 않는 반면 비교기업은 제조를 수행한다. 공시는 해외 3개사에도 AM 사업이 있지만 다른 사업과 대규모 장비 제조를 함께 영위한다고 설명한다.\",\n          \"evidence\": [\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0230\",\n              \"page\": 230,\n              \"claim_id\": \"R_J2_DIFFERENCE\",\n              \"locator\": \"비교기업 선정의 부적합 가능성, 공급망 유사성과 제조 차이\"\n            },\n            {\n              \"doc_id\": \"HDMS-PROS-01\",\n              \"chunk_id\": \"HDMS-PROS-01-p0312\",\n              \"page\": 312,\n              \"claim_id\": \"R_J2_DIFFERENCE\",\n              \"locator\": \"비교회사 선정 결과, 사업 및 자산구조 차이\"\n            }\n          ]\n        }\n      ],\n      \"evidence\": [\n        {\n          \"doc_id\": \"HDMS-PROS-01\",\n          \"chunk_id\": \"HDMS-PROS-01-p0229\",\n          \"page\": 229,\n          \"claim_id\": \"J2\",\n          \"locator\": \"비교기업 선정 절차 및 결과 요약\"\n        },\n        {\n          \"doc_id\": \"HDMS-PROS-01\",\n          \"chunk_id\": \"HDMS-PROS-01-p0230\",\n          \"page\": 230,\n          \"claim_id\": \"J2\",\n          \"locator\": \"최종 비교기업 선정 이유와 공급망 유사성\"\n        }\n      ],\n      \"counter_evidence\": [\n        {\n          \"doc_id\": \"HDMS-PROS-01\",\n          \"chunk_id\": \"HDMS-PROS-01-p0312\",\n          \"page\": 312,\n          \"claim_id\": \"R_J2_DIFFERENCE\",\n          \"locator\": \"비교기업별 사업·자산구조의 유사성 한계\"\n        },\n        {\n          \"doc_id\": \"HDMS-PROS-01\",\n          \"chunk_id\": \"HDMS-PROS-01-p0231\",\n          \"page\": 231,\n          \"claim_id\": \"J2\",\n          \"locator\": \"비교기업의 이종 사업 및 HD한국조선해양과의 사업 연계\"\n        }\n      ],\n      \"unknowns\": [\n        \"사업 구성 차이가 각 회사의 성장률·수익성·위험 및 PER에 미치는 정량적 영향은 제공된 자료만으로 분리할 수 없다.\",\n        \"대안 비교기업이 더 적합한지 또는 네 회사 중 특정 회사를 반드시 제외해야 하는지는 확정할 수 없다.\"\n      ],\n      \"next_action\": \"네 회사 평균을 참고치로 유지하면서 중앙값 및 신조 중심 기업 제외 민감도를 병기한다. 사업 차이가 배수에 미치는 방향은 단정하지 않는다.\"\n    },\n    {\n      \"judgment_id\": \"J3\",\n      \"domain\": \"J3\",\n      \"conclusion\": \"표시 배수를 그대로 사용하는 기준 재계산은 약 106,087원이다. 표시 배수 중앙값을 적용하면 약 107,603원, 신조 비중이 큰 HD한국조선해양을 제외하면 약 100,474원이다. 이는 할인 전 평가가액의 계산상 민감도이지 대안 공모가격이나 권장 배수가 아니다.\",\n     ",
          "type": "output_text",
          "logprobs": []
        }
